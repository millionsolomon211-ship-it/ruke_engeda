// 1. Data Source: Changed from "mongodb" to "postgresql"
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 2. Generator: Creates your "Remote Control" (Prisma Client)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// 3. User Model: Updated IDs for PostgreSQL
model User {
  id            String    @id @default(cuid()) // PostgreSQL uses CUID or UUID strings
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   @db.Text @default("data:image/png;base64,")
  status        String    @default("user")
  username      String?
  phoneNumber   String?
  password      String?
  country       String?
  accounts      Account[]
}

// 4. Account Model: Links social logins (Google, GitHub, etc.) to Users
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// 5. Verification Token Model: Stores temporary 6-digit OTPs
model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}